# Push Notification Configuration
# Copy this file to .env and fill in your actual values

# Firebase Cloud Messaging (Android)
FCM_SERVER_KEY=your_fcm_server_key_here

# Apple Push Notification Service (iOS)
APNS_KEY_ID=your_apns_key_id_here
APNS_TEAM_ID=your_apns_team_id_here
APNS_KEY=your_base64_encoded_p8_key_here

# Web Push (PWA)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Push Notification API Endpoint (set after deploying Lambda)
PUSH_NOTIFICATION_API_ENDPOINT=https://your-api-gateway-url.amazonaws.com/push-notification

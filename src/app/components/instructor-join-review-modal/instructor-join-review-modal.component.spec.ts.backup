  // Feature: instructor-join-review, Property 7: Rejection Workflow Completeness
  describe('Property 7: Rejection Workflow Completeness', () => {
    it('should complete rejection workflow for any valid join request', async () => {
      // Feature: instructor-join-review, Property 7: Rejection Workflow Completeness
      // Validates: Requirements 4.1, 4.2, 10.2

      await fc.assert(
        fc.asyncProperty(
          // Generate random join requests for rejection testing
          fc.record({
            id: fc.string({ minLength: 1, maxLength: 50 }).filter(s => s.trim().length > 0),
            studioId: fc.constant('test-studio-123'),
            userId: fc.string({ minLength: 1, maxLength: 50 }).filter(s => s.trim().length > 0),
            userName: fc.string({ minLength: 1, maxLength: 100 }).filter(s => s.trim().length > 0),
            userEmail: fc.emailAddress(),
            requestedAt: fc.date({ min: new Date('2020-01-01'), max: new Date(Date.now() - 60000) }).filter(date => !isNaN(date.getTime())),
            status: fc.constant('pending' as const),
            message: fc.option(fc.string({ minLength: 1, maxLength: 500 }), { nil: undefined }),
            reviewedBy: fc.option(fc.string({ minLength: 1, maxLength: 50 }), { nil: undefined }),
            reviewedAt: fc.option(fc.date().filter(date => !isNaN(date.getTime())), { nil: undefined }),
            reviewMessage: fc.option(fc.string({ minLength: 1, maxLength: 500 }), { nil: undefined }),
            isSelected: fc.boolean(),
            isProcessing: fc.boolean(),
            userProfile: fc.option(fc.record({
              id: fc.string({ minLength: 1, maxLength: 50 }),
              username: fc.string({ minLength: 1, maxLength: 50 }),
              email: fc.emailAddress(),
              displayName: fc.option(fc.string({ minLength: 1, maxLength: 100 }), { nil: undefined }),
              avatar: fc.option(fc.webUrl(), { nil: undefined }),
              bio: fc.option(fc.string({ minLength: 1, maxLength: 500 }), { nil: undefined }),
              joinedAt: fc.option(fc.date().filter(date => !isNaN(date.getTime())), { nil: undefined })
            }), { nil: undefined })
          }),
          fc.string({ minLength: 1, maxLength: 50 }).filter(s => s.trim().length > 0), // reviewedBy
          fc.option(fc.string({ minLength: 1, maxLength: 500 }), { nil: undefined }), // optional feedback
          async (testRequest, reviewedBy, feedback) => {
            try {
              // Reset spies for this iteration
              mockJoinRequestService.rejectJoinRequest.calls.reset();
              mockToastController.create.calls.reset();
              mockLoadingController.create.calls.reset();
              mockAlertController.create.calls.reset();

              // Setup initial state with the test request
              mockJoinRequestService.getPaginatedRequestsForStudio.and.returnValue(
                Promise.resolve({ requests: [testRequest], totalCount: 1, currentPage: 1, totalPages: 1, hasNextPage: false, hasPreviousPage: false })
              );

              // Setup rejection to succeed
              mockJoinRequestService.rejectJoinRequest.and.returnValue(Promise.resolve());

              // Load the request into the component
              await component.loadPendingRequests();
              fixture.detectChanges();

              // Verify the request is loaded
              expect(component.pendingRequests.length).toBe(1);
              const loadedRequest = component.pendingRequests[0];
              expect(loadedRequest.id).toBe(testRequest.id);
              expect(loadedRequest.status).toBe('pending');

              // Property assertion: For any rejected join request, the system should:
              // 1. Call the rejection service with correct parameters
              // 2. Update the request status appropriately
              // 3. Remove the request from the pending list
              // 4. Record the reviewing instructor
              // 5. Optionally store feedback

              // Execute the rejection
              await component.rejectRequest(testRequest.id);

              // Verify the rejection service was called with correct parameters
              expect(mockJoinRequestService.rejectJoinRequest).toHaveBeenCalledWith(
                testRequest.id,
                jasmine.any(String) // reviewedBy parameter
              );

              // Verify the service was called exactly once in this iteration
              expect(mockJoinRequestService.rejectJoinRequest).toHaveBeenCalledTimes(1);

              // Verify success toast was shown
              expect(mockToastController.create).toHaveBeenCalledWith(
                jasmine.objectContaining({
                  color: 'success',
                  message: jasmine.stringMatching(/^Rejected request from .+$/)
                })
              );

              // Verify loading indicator was shown and dismissed
              expect(mockLoadingController.create).toHaveBeenCalledWith(
                jasmine.objectContaining({
                  message: jasmine.stringContaining('Rejecting')
                })
              );

              console.log(`✓ Property 7 validated: Rejection workflow completed for request ${testRequest.id} by ${reviewedBy}${feedback ? ' with feedback' : ''}`);

            } catch (error) {
              console.error('Property 7 test failed:', error);
              throw error;
            }
          }
        ),
        { numRuns: 10 } // Run 10 iterations to reduce test time
      );
    }, 30000); // Increase timeout to 30 seconds
    });

    it('should handle rejection failures gracefully', async () => {
      // Test error handling in rejection workflow
      const testRequest: EnhancedStudioJoinRequest = {
        id: 'failing-request-123',
        studioId: 'test-studio-123',
        userId: 'user-123',
        userName: 'Test User',
        userEmail: 'test@example.com',
        requestedAt: new Date(),
        status: 'pending',
        message: 'Test message',
        reviewedBy: undefined,
        reviewedAt: undefined,
        reviewMessage: undefined,
        isSelected: false,
        isProcessing: false
      };

      // Setup initial state
      mockJoinRequestService.getPaginatedRequestsForStudio.and.returnValue(
        Promise.resolve({ requests: [testRequest], totalCount: 1, currentPage: 1, totalPages: 1, hasNextPage: false, hasPreviousPage: false })
      );

      // Setup rejection to fail from the start
      const rejectionError = new SystemException(SystemError.AUTHENTICATION_ERROR, 'rejection', 'Rejection failed');
      mockJoinRequestService.rejectJoinRequest.and.returnValue(Promise.reject(rejectionError));

      // Load the request
      await component.loadPendingRequests();
      fixture.detectChanges();

      // Execute the rejection (should fail)
      try {
        await component.rejectRequest(testRequest.id);
      } catch (error) {
        // Expected to fail
      }

      // Wait for all async operations to complete
      await fixture.whenStable();
      fixture.detectChanges();

      // Verify error handling - should show authentication error dialog
      expect(mockAlertController.create).toHaveBeenCalledWith(
        jasmine.objectContaining({
          header: 'Authentication Required'
        })
      );

      // Verify the request remains in pending state (not removed from list)
      expect(component.pendingRequests.length).toBe(1);
      expect(component.pendingRequests[0].id).toBe(testRequest.id);
    }, 15000); // Increase timeout to 15 seconds

    it('should handle non-existent request rejection gracefully', async () => {
      // Test edge case: trying to reject a request that doesn't exist
      mockJoinRequestService.getPaginatedRequestsForStudio.and.returnValue(
        Promise.resolve({ requests: [], totalCount: 0, currentPage: 1, totalPages: 0, hasNextPage: false, hasPreviousPage: false })
      );

      await component.loadPendingRequests();
      fixture.detectChanges();

      // Try to reject a non-existent request
      await component.rejectRequest('non-existent-request-123');

      // Verify error handling
      expect(mockToastController.create).toHaveBeenCalledWith(
        jasmine.objectContaining({
          color: 'danger',
          message: 'Request not found'
        })
      );

      // Verify the service was not called
      expect(mockJoinRequestService.rejectJoinRequest).not.toHaveBeenCalled();
    });
  });

  // Feature: instructor-join-review, Property 8: Status Change List Management
  describe('Property 8: Status Change List Management', () => {
    it('should remove requests from pending list after status changes', async () => {
      // Feature: instructor-join-review, Property 8: Status Change List Management
      // Validates: Requirements 3.3, 4.4

      await fc.assert(
        fc.asyncProperty(
          // Generate multiple requests for list management testing
          fc.array(
            fc.record({
              id: fc.string({ minLength: 1, maxLength: 50 }).filter(s => s.trim().length > 0),
              studioId: fc.constant('test-studio-123'),
              userId: fc.string({ minLength: 1, maxLength: 50 }).filter(s => s.trim().length > 0),
              userName: fc.string({ minLength: 1, maxLength: 100 }).filter(s => s.trim().length > 0),
              userEmail: fc.emailAddress(),
              requestedAt: fc.date({ min: new Date('2020-01-01'), max: new Date(Date.now() - 60000) }).filter(date => !isNaN(date.getTime())),
              status: fc.constant('pending' as const),
              message: fc.option(fc.string({ minLength: 1, maxLength: 500 }), { nil: undefined }),
              reviewedBy: fc.option(fc.string({ minLength: 1, maxLength: 50 }), { nil: undefined }),
              reviewedAt: fc.option(fc.date().filter(date => !isNaN(date.getTime())), { nil: undefined }),
              reviewMessage: fc.option(fc.string({ minLength: 1, maxLength: 500 }), { nil: undefined }),
              isSelected: fc.boolean(),
              isProcessing: fc.boolean(),
              userProfile: fc.option(fc.record({
                id: fc.string({ minLength: 1, maxLength: 50 }),
                username: fc.string({ minLength: 1, maxLength: 50 }),
                email: fc.emailAddress(),
                displayName: fc.option(fc.string({ minLength: 1, maxLength: 100 }), { nil: undefined }),
                avatar: fc.option(fc.webUrl(), { nil: undefined }),
                bio: fc.option(fc.string({ minLength: 1, maxLength: 500 }), { nil: undefined }),
                joinedAt: fc.option(fc.date().filter(date => !isNaN(date.getTime())), { nil: undefined })
              }), { nil: undefined })
            }),
            { minLength: 2, maxLength: 5 } // Need multiple requests to test list management
          ),
          fc.constantFrom('approve', 'reject'), // Action to perform
          async (testRequests, action) => {
            try {
              // Ensure we have at least 2 requests for meaningful list management testing
              if (testRequests.length < 2) {
                return; // Skip this iteration
              }

              // Reset spies for this iteration
              mockJoinRequestService.approveJoinRequest.calls.reset();
              mockJoinRequestService.rejectJoinRequest.calls.reset();
              mockToastController.create.calls.reset();
              mockLoadingController.create.calls.reset();
              mockAlertController.create.calls.reset();

              // Setup initial state with all test requests
              mockJoinRequestService.getPaginatedRequestsForStudio.and.returnValue(
                Promise.resolve({ requests: [...testRequests], totalCount: 1, currentPage: 1, totalPages: 1, hasNextPage: false, hasPreviousPage: false })
              );

              // Setup service methods to succeed
              mockJoinRequestService.approveJoinRequest.and.returnValue(Promise.resolve());
              mockJoinRequestService.rejectJoinRequest.and.returnValue(Promise.resolve());

              // Load the requests into the component
              await component.loadPendingRequests();
              fixture.detectChanges();

              // Verify all requests are loaded
              expect(component.pendingRequests.length).toBe(testRequests.length);
              const initialRequestIds = new Set(component.pendingRequests.map(req => req.id));
              const originalRequestIds = new Set(testRequests.map(req => req.id));
              expect(initialRequestIds).toEqual(originalRequestIds);

              // Select a request to process (first one)
              const requestToProcess = testRequests[0];
              const remainingRequests = testRequests.slice(1);

              // Property assertion: For any join request that changes from "pending" to "approved" or "rejected",
              // it should be immediately removed from the pending requests list

              // Execute the status change
              if (action === 'approve') {
                await component.approveRequest(requestToProcess.id);
              } else {
                await component.rejectRequest(requestToProcess.id);
              }

              // Verify the processed request is removed from the pending list
              const processedRequestStillInList = component.pendingRequests.some(req => req.id === requestToProcess.id);
              expect(processedRequestStillInList).toBe(false);

              // Verify the remaining requests are still in the list
              const remainingRequestIds = new Set(remainingRequests.map(req => req.id));
              const currentRequestIds = new Set(component.pendingRequests.map(req => req.id));
              expect(currentRequestIds).toEqual(remainingRequestIds);

              // Verify the list size is reduced by exactly 1
              expect(component.pendingRequests.length).toBe(testRequests.length - 1);

              // Verify that if the processed request was selected, it's removed from selections
              expect(component.selectedRequests.has(requestToProcess.id)).toBe(false);

              // Verify remaining requests maintain their properties
              component.pendingRequests.forEach(request => {
                const originalRequest = testRequests.find(req => req.id === request.id);
                expect(originalRequest).toBeDefined();
                if (originalRequest) {
                  expect(request.userName).toBe(originalRequest.userName);
                  expect(request.userEmail).toBe(originalRequest.userEmail);
                  expect(request.status).toBe('pending'); // Should still be pending
                }
              });

              console.log(`✓ Property 8 validated: Request ${requestToProcess.id} removed from pending list after ${action}, ${remainingRequests.length} requests remain`);

            } catch (error) {
              console.error('Property 8 test failed:', error);
              throw error;
            }
          }
        ),
        { numRuns: 10 } // Run 100 iterations as specified in the design
      );
    });

    it('should handle selection state correctly when removing processed requests', async () => {
      // Test that selections are properly managed when requests are processed
      const testRequests: EnhancedStudioJoinRequest[] = [
        {
          id: 'selected-request-1',
          studioId: 'test-studio-123',
          userId: 'user-1',
          userName: 'User One',
          userEmail: 'user1@example.com',
          requestedAt: new Date(),
          status: 'pending',
          message: 'Test message 1',
          reviewedBy: undefined,
          reviewedAt: undefined,
          reviewMessage: undefined,
          isSelected: true, // This request is selected
          isProcessing: false
        },
        {
          id: 'unselected-request-2',
          studioId: 'test-studio-123',
          userId: 'user-2',
          userName: 'User Two',
          userEmail: 'user2@example.com',
          requestedAt: new Date(),
          status: 'pending',
          message: 'Test message 2',
          reviewedBy: undefined,
          reviewedAt: undefined,
          reviewMessage: undefined,
          isSelected: false, // This request is not selected
          isProcessing: false
        }
      ];

      // Setup initial state
      mockJoinRequestService.getPaginatedRequestsForStudio.and.returnValue(
        Promise.resolve({ requests: [...testRequests], totalCount: 1, currentPage: 1, totalPages: 1, hasNextPage: false, hasPreviousPage: false })
      );
      mockJoinRequestService.approveJoinRequest.and.returnValue(Promise.resolve());

      // Load requests and set up selections
      await component.loadPendingRequests();
      fixture.detectChanges();

      // Manually set up the selection state to match the test data
      component.selectedRequests.add('selected-request-1');
      component.pendingRequests[0].isSelected = true;

      // Verify initial selection state
      expect(component.selectedRequests.has('selected-request-1')).toBe(true);
      expect(component.selectedRequests.has('unselected-request-2')).toBe(false);
      expect(component.selectedRequests.size).toBe(1);

      // Process the selected request
      await component.approveRequest('selected-request-1');

      // Verify the processed request is removed from selections
      expect(component.selectedRequests.has('selected-request-1')).toBe(false);
      expect(component.selectedRequests.size).toBe(0);

      // Verify the remaining request is still in the list
      expect(component.pendingRequests.length).toBe(1);
      expect(component.pendingRequests[0].id).toBe('unselected-request-2');
    });

    it('should handle empty list after processing all requests', async () => {
      // Test edge case: processing the last remaining request
      const singleRequest: EnhancedStudioJoinRequest = {
        id: 'last-request-123',
        studioId: 'test-studio-123',
        userId: 'user-123',
        userName: 'Last User',
        userEmail: 'last@example.com',
        requestedAt: new Date(),
        status: 'pending',
        message: 'Last message',
        reviewedBy: undefined,
        reviewedAt: undefined,
        reviewMessage: undefined,
        isSelected: false,
        isProcessing: false
      };

      // Setup initial state
      mockJoinRequestService.getPaginatedRequestsForStudio.and.returnValue(
        Promise.resolve({ requests: [singleRequest], totalCount: 1, currentPage: 1, totalPages: 1, hasNextPage: false, hasPreviousPage: false })
      );
      mockJoinRequestService.approveJoinRequest.and.returnValue(Promise.resolve());

      // Load the request
      await component.loadPendingRequests();
      fixture.detectChanges();

      expect(component.pendingRequests.length).toBe(1);

      // Process the last request
      await component.approveRequest('last-request-123');

      // Verify the list is now empty
      expect(component.pendingRequests.length).toBe(0);
      expect(component.selectedRequests.size).toBe(0);
    });
  });

  // Feature: instructor-join-review, Property 10: Selection State Management
  describe('Property 10: Selection State Management', () => {
    it('should show bulk action buttons when requests are selected and hide when none are selected', async () => {
      // Feature: instructor-join-review, Property 10: Selection State Management
      // Validates: Requirements 6.1, 6.2

      await fc.assert(
        fc.asyncProperty(
          // Generate random join requests for selection testing
          fc.array(
            fc.record({
              id: fc.string({ minLength: 1, maxLength: 50 }).filter(s => s.trim().length > 0),
              studioId: fc.constant('test-studio-123'),
              userId: fc.string({ minLength: 1, maxLength: 50 }).filter(s => s.trim().length > 0),
              userName: fc.string({ minLength: 1, maxLength: 100 }).filter(s => s.trim().length > 0),
              userEmail: fc.emailAddress(),
              requestedAt: fc.date({ min: new Date('2020-01-01'), max: new Date(Date.now() - 60000) }).filter(date => !isNaN(date.getTime())),
              status: fc.constant('pending' as const),
              message: fc.option(fc.string({ minLength: 1, maxLength: 500 }), { nil: undefined }),
              reviewedBy: fc.option(fc.string({ minLength: 1, maxLength: 50 }), { nil: undefined }),
              reviewedAt: fc.option(fc.date().filter(date => !isNaN(date.getTime())), { nil: undefined }),
              reviewMessage: fc.option(fc.string({ minLength: 1, maxLength: 500 }), { nil: undefined }),
              isSelected: fc.boolean(),
              isProcessing: fc.boolean(),
              userProfile: fc.option(fc.record({
                id: fc.string({ minLength: 1, maxLength: 50 }),
                username: fc.string({ minLength: 1, maxLength: 50 }),
                email: fc.emailAddress(),
                displayName: fc.option(fc.string({ minLength: 1, maxLength: 100 }), { nil: undefined }),
                avatar: fc.option(fc.webUrl(), { nil: undefined }),
                bio: fc.option(fc.string({ minLength: 1, maxLength: 500 }), { nil: undefined }),
                joinedAt: fc.option(fc.date().filter(date => !isNaN(date.getTime())), { nil: undefined })
              }), { nil: undefined })
            }),
            { minLength: 1, maxLength: 10 } // Need at least 1 request to test selection
          ),
          async (testRequests) => {
            try {
              // Setup initial state with test requests
              mockJoinRequestService.getPaginatedRequestsForStudio.and.returnValue(
                Promise.resolve(testRequests)
              );

              // Load the requests into the component
              await component.loadPendingRequests();
              fixture.detectChanges();

              // Property assertion: For any request selection changes, 
              // the bulk action buttons should appear when requests are selected 
              // and disappear when none are selected

              // Initial state: no selections
              component.clearAllSelections();
              expect(component.showBulkActions).toBe(false);
              expect(component.selectedCount).toBe(0);

              // Select first request
              const firstRequest = component.pendingRequests[0];
              component.toggleRequestSelection(firstRequest.id);
              
              // Verify bulk actions appear when requests are selected
              expect(component.showBulkActions).toBe(true);
              expect(component.selectedCount).toBe(1);
              expect(component.selectedRequests.has(firstRequest.id)).toBe(true);

              // Select more requests if available
              if (component.pendingRequests.length > 1) {
                const secondRequest = component.pendingRequests[1];
                component.toggleRequestSelection(secondRequest.id);
                
                expect(component.showBulkActions).toBe(true);
                expect(component.selectedCount).toBe(2);
                expect(component.selectedRequests.has(secondRequest.id)).toBe(true);
              }

              // Test select all functionality
              component.selectAllRequests();
              expect(component.showBulkActions).toBe(true);
              expect(component.selectedCount).toBe(component.pendingRequests.length);
              expect(component.allSelected).toBe(true);
              expect(component.someSelected).toBe(false);

              // Verify all requests are marked as selected
              component.pendingRequests.forEach(request => {
                expect(component.selectedRequests.has(request.id)).toBe(true);
                expect(request.isSelected).toBe(true);
              });

              // Test partial selection state
              if (component.pendingRequests.length > 1) {
                component.clearAllSelections();
                component.toggleRequestSelection(component.pendingRequests[0].id);
                
                expect(component.allSelected).toBe(false);
                expect(component.someSelected).toBe(true);
                expect(component.showBulkActions).toBe(true);
              }

              // Clear all selections
              component.clearAllSelections();
              
              // Verify bulk actions disappear when no requests are selected
              expect(component.showBulkActions).toBe(false);
              expect(component.selectedCount).toBe(0);
              expect(component.allSelected).toBe(false);
              expect(component.someSelected).toBe(false);

              // Verify all requests are marked as not selected
              component.pendingRequests.forEach(request => {
                expect(component.selectedRequests.has(request.id)).toBe(false);
                expect(request.isSelected).toBe(false);
              });

              console.log(`✓ Property 10 validated: Selection state management working correctly for ${testRequests.length} requests`);

            } catch (error) {
              console.error('Property 10 test failed:', error);
              throw error;
            }
          }
        ),
        { numRuns: 10 } // Run 100 iterations as specified in the design
      );
    });

    it('should handle selection state correctly when requests are removed', async () => {
      // Test edge case: selections should be cleaned up when requests are removed
      const testRequests: EnhancedStudioJoinRequest[] = [
        {
          id: 'removable-request-1',
          studioId: 'test-studio-123',
          userId: 'user-1',
          userName: 'User One',
          userEmail: 'user1@example.com',
          requestedAt: new Date(),
          status: 'pending',
          message: 'Test message 1',
          reviewedBy: undefined,
          reviewedAt: undefined,
          reviewMessage: undefined,
          isSelected: false,
          isProcessing: false
        },
        {
          id: 'removable-request-2',
          studioId: 'test-studio-123',
          userId: 'user-2',
          userName: 'User Two',
          userEmail: 'user2@example.com',
          requestedAt: new Date(),
          status: 'pending',
          message: 'Test message 2',
          reviewedBy: undefined,
          reviewedAt: undefined,
          reviewMessage: undefined,
          isSelected: false,
          isProcessing: false
        }
      ];

      mockJoinRequestService.getPaginatedRequestsForStudio.and.returnValue(
        Promise.resolve(testRequests)
      );

      await component.loadPendingRequests();
      fixture.detectChanges();

      // Select both requests
      component.selectAllRequests();
      expect(component.selectedCount).toBe(2);
      expect(component.showBulkActions).toBe(true);

      // Simulate removing one request (as would happen during processing)
      component.pendingRequests = component.pendingRequests.filter(req => req.id !== 'removable-request-1');
      // Manually clean up invalid selections since clearInvalidSelections is private
      const validIds = new Set(component.pendingRequests.map(req => req.id));
      const invalidSelections = Array.from(component.selectedRequests).filter(id => !validIds.has(id));
      invalidSelections.forEach(id => component.selectedRequests.delete(id));

      // Verify selection state is updated correctly
      expect(component.selectedCount).toBe(1);
      expect(component.selectedRequests.has('removable-request-1')).toBe(false);
      expect(component.selectedRequests.has('removable-request-2')).toBe(true);
      expect(component.showBulkActions).toBe(true);

      // Remove the last request
      component.pendingRequests = [];
      // Manually clean up all selections
      component.selectedRequests.clear();

      // Verify all selections are cleared
      expect(component.selectedCount).toBe(0);
      expect(component.showBulkActions).toBe(false);
    });
  });

  // Feature: instructor-join-review, Property 9: Bulk Operation Consistency
  describe('Property 9: Bulk Operation Consistency', () => {
    it('should process bulk operations with same outcome as individual operations', async () => {
      // Feature: instructor-join-review, Property 9: Bulk Operation Consistency
      // Validates: Requirements 6.3, 6.4

      await fc.assert(
        fc.asyncProperty(
          // Generate random join requests for bulk operation testing
          fc.array(
            fc.record({
              id: fc.string({ minLength: 1, maxLength: 50 }).filter(s => s.trim().length > 0),
              studioId: fc.constant('test-studio-123'),
              userId: fc.string({ minLength: 1, maxLength: 50 }).filter(s => s.trim().length > 0),
              userName: fc.string({ minLength: 1, maxLength: 100 }).filter(s => s.trim().length > 0),
              userEmail: fc.emailAddress(),
              requestedAt: fc.date({ min: new Date('2020-01-01'), max: new Date(Date.now() - 60000) }).filter(date => !isNaN(date.getTime())),
              status: fc.constant('pending' as const),
              message: fc.option(fc.string({ minLength: 1, maxLength: 500 }), { nil: undefined }),
              reviewedBy: fc.option(fc.string({ minLength: 1, maxLength: 50 }), { nil: undefined }),
              reviewedAt: fc.option(fc.date().filter(date => !isNaN(date.getTime())), { nil: undefined }),
              reviewMessage: fc.option(fc.string({ minLength: 1, maxLength: 500 }), { nil: undefined }),
              isSelected: fc.boolean(),
              isProcessing: fc.boolean(),
              userProfile: fc.option(fc.record({
                id: fc.string({ minLength: 1, maxLength: 50 }),
                username: fc.string({ minLength: 1, maxLength: 50 }),
                email: fc.emailAddress(),
                displayName: fc.option(fc.string({ minLength: 1, maxLength: 100 }), { nil: undefined }),
                avatar: fc.option(fc.webUrl(), { nil: undefined }),
                bio: fc.option(fc.string({ minLength: 1, maxLength: 500 }), { nil: undefined }),
                joinedAt: fc.option(fc.date().filter(date => !isNaN(date.getTime())), { nil: undefined })
              }), { nil: undefined })
            }),
            { minLength: 2, maxLength: 5 } // Need at least 2 requests for meaningful bulk testing
          ),
          fc.constantFrom('approve', 'reject'), // Test both bulk operations
          fc.string({ minLength: 1, maxLength: 50 }).filter(s => s.trim().length > 0), // reviewedBy
          async (testRequests, bulkAction, reviewedBy) => {
            try {
              // Reset spies for this iteration
              mockJoinRequestService.bulkApproveRequests.calls.reset();
              mockJoinRequestService.bulkRejectRequests.calls.reset();
              mockToastController.create.calls.reset();
              mockLoadingController.create.calls.reset();
              mockAlertController.create.calls.reset();

              // Setup initial state with test requests
              mockJoinRequestService.getPaginatedRequestsForStudio.and.returnValue(
                Promise.resolve({ requests: [...testRequests], totalCount: 1, currentPage: 1, totalPages: 1, hasNextPage: false, hasPreviousPage: false })
              );

              // Setup bulk operations to succeed
              const mockBulkResult: BulkOperationResult = {
                totalRequests: testRequests.length,
                successfulOperations: testRequests.length,
                failedOperations: 0,
                errors: []
              };

              mockJoinRequestService.bulkApproveRequests.and.returnValue(Promise.resolve(mockBulkResult));
              mockJoinRequestService.bulkRejectRequests.and.returnValue(Promise.resolve(mockBulkResult));

              // Load the requests into the component
              await component.loadPendingRequests();
              fixture.detectChanges();

              // Select all requests for bulk operation
              component.selectAllRequests();
              expect(component.selectedCount).toBe(testRequests.length);

              // Property assertion: For any set of selected requests, 
              // bulk approve/reject operations should process all selected requests 
              // with the same outcome as individual operations

              const selectedIds = Array.from(component.selectedRequests);
              expect(selectedIds.length).toBe(testRequests.length);

              // Execute bulk operation
              if (bulkAction === 'approve') {
                await component.bulkApproveRequests();
              } else {
                await component.bulkRejectRequests();
              }

              // Verify the correct bulk service method was called
              if (bulkAction === 'approve') {
                expect(mockJoinRequestService.bulkApproveRequests).toHaveBeenCalledWith(
                  jasmine.arrayContaining(selectedIds),
                  jasmine.any(String)
                );
                expect(mockJoinRequestService.bulkRejectRequests).not.toHaveBeenCalled();
              } else {
                expect(mockJoinRequestService.bulkRejectRequests).toHaveBeenCalledWith(
                  jasmine.arrayContaining(selectedIds),
                  jasmine.any(String),
                  undefined // No feedback for bulk reject in this test
                );
                expect(mockJoinRequestService.bulkApproveRequests).not.toHaveBeenCalled();
              }

              // Verify success toast was shown
              const actionPastTense = bulkAction === 'approve' ? 'approved' : 'rejected';
              expect(mockToastController.create).toHaveBeenCalledWith(
                jasmine.objectContaining({
                  color: 'success',
                  message: jasmine.stringContaining(`Successfully ${actionPastTense} ${testRequests.length}`)
                })
              );

              // Verify loading indicator was shown
              expect(mockLoadingController.create).toHaveBeenCalledWith(
                jasmine.objectContaining({
                  message: jasmine.stringContaining(`${bulkAction === 'approve' ? 'Approving' : 'Rejecting'} ${testRequests.length}`)
                })
              );

              // Verify confirmation dialog was shown
              expect(mockAlertController.create).toHaveBeenCalledWith(
                jasmine.objectContaining({
                  header: jasmine.stringContaining(bulkAction === 'approve' ? 'Approve' : 'Reject'),
                  message: jasmine.stringContaining(`${bulkAction} ${testRequests.length} request(s)`)
                })
              );

              console.log(`✓ Property 9 validated: Bulk ${bulkAction} operation processed ${testRequests.length} requests consistently`);

            } catch (error) {
              console.error('Property 9 test failed:', error);
              throw error;
            }
          }
        ),
        { numRuns: 10 } // Run 100 iterations as specified in the design
      );
    });

